{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@ng-linguo/linguo": ["./packages/linguo/src/index.ts"],
      "@ng-linguo/linguo/icu": ["./packages/linguo/icu/src/index.ts"],
      "@ng-linguo/linguo/http": ["./packages/linguo/http/src/index.ts"],
      "@ng-linguo/extract": ["./packages/extract/src/index.ts"],
      "@ng-linguo/eslint-plugin": ["./packages/eslint-plugin/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
