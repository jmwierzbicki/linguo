{
  "name": "linguo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/linguo/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:core"],
  "targets": {
    "sync-readme": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/sync-readme.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "dependsOn": ["sync-readme"],
      "options": {
        "project": "packages/linguo/ng-package.json",
        "tsConfig": "packages/linguo/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/linguo/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/linguo/jest.config.cts",
        "tsConfig": "packages/linguo/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
