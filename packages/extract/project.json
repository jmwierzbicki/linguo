{
  "name": "extract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/extract/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/extract",
        "main": "packages/extract/src/index.ts",
        "tsConfig": "packages/extract/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/extract",
            "glob": "*.md",
            "output": "."
          },
          {
            "input": "packages/extract/src/lib",
            "glob": "*.txt",
            "output": "src/lib"
          },
          {
            "input": "packages/extract/schema",
            "glob": "linguo.config.schema.json",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
