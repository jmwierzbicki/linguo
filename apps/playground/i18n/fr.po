msgid ".input {$count :number} .match $count one {{{$count} file}} * {{{$count} files}}"
msgstr ".input {$count :number} .match $count 0 {{Aucun fichier}} one {{Un fichier}} * {{{$count} fichiers}}"

#: apps/playground/src/app/app.ts:83
msgid ".input {$count :number} .match $count one {{{$count} item in your cart}} * {{{$count} items in your cart}}"
msgstr ".input {$count :number} .match $count 0 {{Aucun article dans votre panier}} one {{Un article dans votre panier}} * {{{$count} articles dans votre panier}}"

#: apps/playground/src/app/app.ts:88
msgid ".input {$count :number} .match $count 0 {{No new messages}} one {{{$count} new message}} * {{{$count} new messages}}"
msgstr ".input {$count :number} .match $count 0 {{Aucun nouveau message}} one {{Un nouveau message}} * {{{$count} nouveaux messages}}"

#: apps/playground/src/app/app.ts:93
msgid ".input {$place :number select=ordinal} .match $place one {{You finished {$place}st}} two {{You finished {$place}nd}} few {{You finished {$place}rd}} * {{You finished {$place}th}}"
msgstr ".input {$place :number select=ordinal} .match $place one {{Vous avez terminé {$place}er}} * {{Vous avez terminé {$place}ème}}"

#: apps/playground/src/app/app.ts:98
msgid ".input {$gender :string} .match $gender female {{She invited you}} male {{He invited you}} * {{They invited you}}"
msgstr ".input {$gender :string} .match $gender female {{Elle vous a invitée}} male {{Il vous a invité}} * {{Ils vous ont invité(e)s}}"

#: apps/playground/src/app/app.ts:104
msgid ".input {$count :number} .input {$gender :string} .match $count $gender one female {{She has {$count} follower}} one male {{He has {$count} follower}} * female {{She has {$count} followers}} * male {{He has {$count} followers}} * * {{They have {$count} followers}}"
msgstr ".input {$count :number} .input {$gender :string} .match $count $gender one féminin {{Elle a {$count} abonnée}} one masculin {{Il a {$count} abonné}} * féminin {{Elle a {$count} abonnées}} * masculin {{Il a {$count} abonnés}} * * {{Ils ont {$count} abonnés}}"

