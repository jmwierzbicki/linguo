msgstr ".input {$count :number} .match $count 0 {{0 przedmiotów w koszyku}} one {{{$count} przedmiot w koszyku}} few {{{$count} przedmioty w koszyku}} many {{{$count} przedmiotów w koszyku}} * {{{$count} przedmiotu w koszyku}}"

