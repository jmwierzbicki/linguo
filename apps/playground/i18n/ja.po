msgctxt "audio player"
msgid "Play"
msgstr "再生"

#: apps/playground/src/app/app.html:361
msgctxt "game"
msgid "Play"
msgstr "プレイ"

#: apps/playground/src/app/app.html:364
msgctxt "direction"
msgid "Right"
msgstr "右"

#: apps/playground/src/app/app.html:364
msgctxt "correct"
msgid "Right"
msgstr "正しい"

#: apps/playground/src/app/app.html:368
msgctxt "sequence"
msgid "Order"
msgstr "順序"

#: apps/playground/src/app/app.html:368
msgctxt "purchase"
msgid "Order"
