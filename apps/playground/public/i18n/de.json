  ".input {$count :number} .match $count one {{{$count} file}} * {{{$count} files}}": ".input {$count :number} .match $count 0 {{Keine Dateien}} one {{{$count} Datei}} * {{{$count} Dateien}}",
  ".input {$count :number} .match $count one {{{$count} item in your cart}} * {{{$count} items in your cart}}": ".input {$count :number} .match $count 0 {{Keine Artikel in Ihrem Warenkorb}} one {{{$count} Artikel in Ihrem Warenkorb}} * {{{$count} Artikel in Ihrem Warenkorb}}",
  ".input {$count :number} .match $count 0 {{No new messages}} one {{{$count} new message}} * {{{$count} new messages}}": ".input {$count :number} .match $count 0 {{Keine neuen Nachrichten}} one {{{$count} neue Nachricht}} * {{{$count} neue Nachrichten}}",
  ".input {$place :number select=ordinal} .match $place one {{You finished {$place}st}} two {{You finished {$place}nd}} few {{You finished {$place}rd}} * {{You finished {$place}th}}": ".input {$place :number select=ordinal} .match $place * {{Sie sind {$place}. geworden}}",
  ".input {$gender :string} .match $gender female {{She invited you}} male {{He invited you}} * {{They invited you}}": ".input {$gender :string} .match $gender female {{Sie hat Sie eingeladen}} male {{Er hat Sie eingeladen}} * {{Jemand hat Sie eingeladen}}",
  ".input {$count :number} .input {$gender :string} .match $count $gender one female {{She has {$count} follower}} one male {{He has {$count} follower}} * female {{She has {$count} followers}} * male {{He has {$count} followers}} * * {{They have {$count} followers}}": ".input {$count :number} .input {$gender :string} .match $count $gender 0 female {{Sie hat keine Follower}} 0 male {{Er hat keine Follower}} 0 * {{Jemand hat keine Follower}} * female {{Sie hat {$count} Follower}} * male {{Er hat {$count} Follower}} * * {{Jemand hat {$count} Follower}}",
  "This city has {$n :number} residents": "Diese Stadt hat {$n :number} Einwohner",
