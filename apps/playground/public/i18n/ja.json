  ".input {$count :number} .match $count one {{{$count} file}} * {{{$count} files}}": ".input {$count :number} .match $count * {{{$count} ファイル}}",
  ".input {$count :number} .match $count one {{{$count} item in your cart}} * {{{$count} items in your cart}}": ".input {$count :number} .match $count * {{カートに{$count}個の商品}}",
  ".input {$count :number} .match $count 0 {{No new messages}} one {{{$count} new message}} * {{{$count} new messages}}": ".input {$count :number} .match $count 0 {{新しいメッセージはありません}} * {{{$count}件の新しいメッセージ}}",
  ".input {$place :number select=ordinal} .match $place one {{You finished {$place}st}} two {{You finished {$place}nd}} few {{You finished {$place}rd}} * {{You finished {$place}th}}": ".input {$place :number select=ordinal} .match $place * {{あなたは{$place}位でフィニッシュしました}}",
  ".input {$gender :string} .match $gender female {{She invited you}} male {{He invited you}} * {{They invited you}}": ".input {$gender :string} .match $gender female {{彼女があなたを招待しました}} male {{彼があなたを招待しました}} * {{招待されました}}",
  ".input {$count :number} .input {$gender :string} .match $count $gender one female {{She has {$count} follower}} one male {{He has {$count} follower}} * female {{She has {$count} followers}} * male {{He has {$count} followers}} * * {{They have {$count} followers}}": ".input {$count :number} .input {$gender :string} .match $count $gender * female {{彼女には{$count}人のフォロワーがいます}} * male {{彼には{$count}人のフォロワーがいます}} * * {{{$count}人のフォロワーがいます}}",
  "This city has {$n :number} residents": "この都市には{$n}人の住民がいます",
