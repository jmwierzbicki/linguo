  ".input {$count :number} .match $count one {{{$count} file}} * {{{$count} files}}": ".input {$count :number} .match $count 0 {{Aucun fichier}} one {{Un fichier}} * {{{$count} fichiers}}",
  ".input {$count :number} .match $count one {{{$count} item in your cart}} * {{{$count} items in your cart}}": ".input {$count :number} .match $count 0 {{Aucun article dans votre panier}} one {{Un article dans votre panier}} * {{{$count} articles dans votre panier}}",
  ".input {$count :number} .match $count 0 {{No new messages}} one {{{$count} new message}} * {{{$count} new messages}}": ".input {$count :number} .match $count 0 {{Aucun nouveau message}} one {{Un nouveau message}} * {{{$count} nouveaux messages}}",
  ".input {$place :number select=ordinal} .match $place one {{You finished {$place}st}} two {{You finished {$place}nd}} few {{You finished {$place}rd}} * {{You finished {$place}th}}": ".input {$place :number select=ordinal} .match $place one {{Vous avez terminé {$place}er}} * {{Vous avez terminé {$place}ème}}",
  ".input {$gender :string} .match $gender female {{She invited you}} male {{He invited you}} * {{They invited you}}": ".input {$gender :string} .match $gender female {{Elle vous a invitée}} male {{Il vous a invité}} * {{Ils vous ont invité(e)s}}",
  ".input {$count :number} .input {$gender :string} .match $count $gender one female {{She has {$count} follower}} one male {{He has {$count} follower}} * female {{She has {$count} followers}} * male {{He has {$count} followers}} * * {{They have {$count} followers}}": ".input {$count :number} .input {$gender :string} .match $count $gender one féminin {{Elle a {$count} abonnée}} one masculin {{Il a {$count} abonné}} * féminin {{Elle a {$count} abonnées}} * masculin {{Il a {$count} abonnés}} * * {{Ils ont {$count} abonnés}}",
  "This city has {$n :number} residents": "Cette ville a {$n :number} habitants",
