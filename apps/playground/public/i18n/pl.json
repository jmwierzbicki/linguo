  ".input {$count :number} .match $count one {{{$count} file}} * {{{$count} files}}": ".input {$count :number} .match $count 0 {{0 plików}} one {{{$count} plik}} few {{{$count} pliki}} many {{{$count} plików}} * {{{$count} pliku}}",
  ".input {$count :number} .match $count one {{{$count} item in your cart}} * {{{$count} items in your cart}}": ".input {$count :number} .match $count 0 {{0 przedmiotów w koszyku}} one {{{$count} przedmiot w koszyku}} few {{{$count} przedmioty w koszyku}} many {{{$count} przedmiotów w koszyku}} * {{{$count} przedmiotu w koszyku}}",
  ".input {$count :number} .match $count 0 {{No new messages}} one {{{$count} new message}} * {{{$count} new messages}}": ".input {$count :number} .match $count 0 {{Brak nowych wiadomości}} one {{{$count} nowa wiadomość}} few {{{$count} nowe wiadomości}} many {{{$count} nowych wiadomości}} * {{{$count} nowej wiadomości}}",
  ".input {$place :number select=ordinal} .match $place one {{You finished {$place}st}} two {{You finished {$place}nd}} few {{You finished {$place}rd}} * {{You finished {$place}th}}": ".input {$place :number select=ordinal} .match $place * {{Ukończyłeś {$place}.}}",
  ".input {$gender :string} .match $gender female {{She invited you}} male {{He invited you}} * {{They invited you}}": ".input {$gender :string} .match $gender female {{Ona Cię zaprosiła}} male {{On Cię zaprosił}} * {{Zaprosili Cię}}",
  ".input {$count :number} .input {$gender :string} .match $count $gender one female {{She has {$count} follower}} one male {{He has {$count} follower}} * female {{She has {$count} followers}} * male {{He has {$count} followers}} * * {{They have {$count} followers}}": ".input {$count :number} .input {$gender :string} .match $count $gender one female {{Ona ma {$count} obserwatorkę}} one male {{On ma {$count} obserwatora}} few female {{Ona ma {$count} obserwatorki}} few male {{On ma {$count} obserwatorów}} many female {{Ona ma {$count} obserwatorek}} many male {{On ma {$count} obserwatorów}} * * {{Mają {$count} obserwujących}}",
  "This city has {$n :number} residents": "To miasto ma {$n :number} mieszkańców",
